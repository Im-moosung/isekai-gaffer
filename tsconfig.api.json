{
  // Vercel 서버리스 함수(api/) 전용 타입체크 설정.
  // 앱 빌드(`tsc -b` / `vite build`)와 분리되어 있어 빌드에 영향을 주지 않는다.
  // 수동 검증: `npx tsc -p tsconfig.api.json`
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true
  },
  "include": ["api", "src/ai/prompts.ts", "src/ai/requestGuard.ts", "src/ai/safeguard.ts"]
}
