{
 "schemaVersion": 1,
 "purpose": "토너먼트 8팀 이름 조각 — Qwen은 로컬이라 한도가 없으므로 캠페인 전 경기를 덮는다",
 "voices": {
  "caster": {
   "id": "C3",
   "alias": "정석",
   "speed": 1.2,
   "ko": "캐스터"
  },
  "analyst": {
