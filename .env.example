# 환경 변수 예시 — 이 파일을 .env 로 복사해 값을 채운다.
#
# 전부 선택 사항이다. 하나도 설정하지 않아도 서비스는 전 기능이 동작한다.
#   - AI 키가 없으면 서사(기자회견·헤드라인·엔딩)가 사전 작성 문안으로 대체된다.
#   - Supabase 설정이 없으면 리더보드가 브라우저 localStorage에 기록된다.
#
# 실제 키를 이 파일에 적지 말 것. .env 는 .gitignore 대상이다.

# ── AI 서술 (api/narrate.ts · 서버 전용) ─────────────────────
# 프로바이더 선택: gemini(기본) | anthropic
AI_PROVIDER=gemini

# AI_PROVIDER=gemini 일 때 사용 — Google AI Studio 발급 키
GEMINI_API_KEY=

# AI_PROVIDER=anthropic 일 때 사용 — Anthropic Console 발급 키
ANTHROPIC_API_KEY=

# ── 리더보드 (브라우저 번들에 주입되는 공개 값) ──────────────
# VITE_ 접두사가 붙은 값은 빌드 시 클라이언트 코드에 포함된다.
# anon 키는 공개를 전제로 한 값이므로 service_role 키를 절대 넣지 말 것.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
